{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Valnivo Console",
  "version": "0.17.3",
  "identifier": "eu.valnivo.console",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "Behavioural tests your agents run on the screen you share",
    "copyright": "Valnivo",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5MDEyREE1MjU1NjZEMTUKUldRVmJWWWxwUzBCNlRYR1ZpWFVsYndxcnA4NGRTOTZiOG5jRTExZGowNmxDcUhxVUJnaDM2TDgK",
      "endpoints": [
        "https://github.com/valnivo-labs/valnivo-console-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
